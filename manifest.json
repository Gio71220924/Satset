{
  "manifest_version": 3,
  "name": "Satset",
  "version": "0.3.0",
  "description": "Isi form lamaran kerja otomatis dari satu profil tersimpan di browser.",

  "permissions": ["storage", "activeTab", "scripting"],

  "optional_host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.lever.co/*",
        "https://*.greenhouse.io/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.workable.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://*.bamboohr.com/*",
        "https://*.recruitee.com/*",
        "https://*.teamtailor.com/*",
        "https://*.breezy.hr/*",
        "https://*.jobvite.com/*",
        "https://*.rippling.com/*",
        "https://*.kalibrr.com/*",
        "https://*.jobstreet.co.id/*",
        "https://*.glints.com/*"
      ],
      "js": [
        "src/content/score.js",
        "src/content/dom.js",
        "src/content/match.js",
        "src/content/fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Satset"
  }
}
